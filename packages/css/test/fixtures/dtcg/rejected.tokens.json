{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "p3": { "$type": "color", "$value": { "colorSpace": "display-p3", "components": [1, 0, 0] } },
    "alpha": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 1.5 } }
  },
  "space": {
    "negative": { "$type": "dimension", "$value": { "value": -2, "unit": "px" } },
    "unsupportedUnit": { "$type": "dimension", "$value": { "value": 2, "unit": "em" } },
    "number": { "$type": "number", "$value": 4 }
  },
  "motion": {
    "negative": { "$type": "duration", "$value": { "value": -1, "unit": "ms" } }
  },
  "unsupported": {
    "fontWeight": { "$type": "fontWeight", "$value": 700 },
    "cubicBezier": { "$type": "cubicBezier", "$value": [0, 0, 1, 1] },
    "border": { "$type": "border", "$value": {} },
    "transition": { "$type": "transition", "$value": {} },
    "shadow": { "$type": "shadow", "$value": {} },
    "gradient": { "$type": "gradient", "$value": [] },
    "typography": { "$type": "typography", "$value": {} }
  },
  "opacity": {
    "outOfRange": { "$type": "number", "$value": 1.5 }
  },
  "font": {
    "familyArray": { "$type": "fontFamily", "$value": ["System", "Display"] }
  },
  "line": {
    "styleObject": { "$type": "strokeStyle", "$value": { "dashArray": [2, 1] } }
  }
}
