{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "space": {
    "$description": "Source-tooling spacing conversion cases.",
    "$extensions": { "com.example": { "group": "spacing" } },
    "eight": {
      "$type": "dimension",
      "$description": "Eight-pixel baseline spacing token.",
      "$deprecated": "Prefer the root-scaled token where appropriate.",
      "$extensions": { "com.example": { "category": "spacing" } },
      "$value": { "value": 8, "unit": "px" }
    },
    "root": { "$type": "dimension", "$value": { "value": 1.25, "unit": "rem" } }
  },
  "motion": {
    "quick": { "$type": "duration", "$value": { "value": 125, "unit": "ms" } },
    "slow": { "$type": "duration", "$value": { "value": 0.25, "unit": "s" } }
  },
  "opacity": {
    "disabled": { "$type": "number", "$value": 0.45 }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": "System" }
  },
  "line": {
    "style": { "$type": "strokeStyle", "$value": "dashed" }
  }
}
