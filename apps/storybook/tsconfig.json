{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "strict": true,
    "types": [
      "react",
      "react-native",
      "@storybook/react-native"
    ],
    "paths": {
      "react-native": [
        "./node_modules/react-native"
      ],
      "react-native/*": [
        "./node_modules/react-native/*"
      ]
    }
  },
  "include": [
    "src",
    ".rnstorybook/**/*.ts",
    ".rnstorybook/**/*.tsx",
    "test-types/**/*.ts"
  ]
}
