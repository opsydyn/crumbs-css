+import type { UnbrandedThemeLiteral } from '../theme-token';
+declare const colorBrand: unique symbol;
+declare const typographyBrand: unique symbol;
+export type AlgebraColor = Readonly<{
+    $$type: 'crumbs.css.algebra-color';
+    version: 1;
+    space: 'srgb';
+    components: readonly [
+        number,
+        number,
+        number
+    ];
+    alpha: number;
+    [colorBrand]: true;
+}>;
+export type AlgebraColorInput = UnbrandedThemeLiteral | Readonly<{
+    space: 'srgb';
+    components: readonly [
+        number,
+        number,
+        number
+    ];
+    alpha?: number;
+}>;
+export type ColorInterpolationSpace = 'srgb' | 'srgb-linear';
+export type ColorMixOptions = Readonly<{
+    ratio: number;
+    space: ColorInterpolationSpace;
+}>;
+export type Typography = Readonly<{
+    $$type: 'crumbs.css.typography';
+    version: 1;
+    unit: 'native';
+    fontSize: number;
+    lineHeight: number;
+    letterSpacing: number;
+    [typographyBrand]: true;
+}>;
+export type TypographyInput = Readonly<{
+    fontSize: number;
+    lineHeight: Readonly<{
+        ratio: number;
+        value?: never;
+    }> | Readonly<{
+        value: number;
+        ratio?: never;
+    }>;
+    letterSpacing?: number;
+}>;
+export type TypographyScaleOptions<TSteps extends Readonly<Record<string, number>> = Readonly<Record<string, number>>> = Readonly<{
+    ratio: number;
+    steps: TSteps;
+}>;
+export type TypographyScale<TSteps> = Readonly<{
+    [K in keyof TSteps]: Typography;
+}>;
+export type NativeTypographyStyle = Readonly<{
+    fontSize: number;
+    lineHeight: number;
+    letterSpacing: number;
+}>;
+export type TokenAlgebraErrorCode = 'algebra.invalid-color' | 'algebra.invalid-typography' | 'algebra.invalid-option' | 'algebra.invalid-descriptor' | 'algebra.out-of-range';
+type Closed<T, Keys extends PropertyKey> = Exclude<keyof T, Keys> extends never ? unknown : never;
+export type CheckedColorInput<T> = T extends string ? (T extends UnbrandedThemeLiteral ? unknown : never) : Closed<T, 'space' | 'components' | 'alpha'>;
+export type CheckedMixOptions<T> = Closed<T, 'ratio' | 'space'>;
+export type CheckedTypographyInput<T> = Closed<T, 'fontSize' | 'lineHeight' | 'letterSpacing'> & (T extends {
+    lineHeight: infer L;
+} ? Closed<L, 'ratio' | 'value'> : never);
+type FiniteNames<T> = string extends keyof T ? never : number extends keyof T ? never : symbol extends keyof T ? never : Exclude<keyof T, string> extends never ? unknown : never;
+export type CheckedScaleOptions<T> = Closed<T, 'ratio' | 'steps'> & (T extends {
+    steps: infer S;
+} ? FiniteNames<S> : never);
