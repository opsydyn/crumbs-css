+import assert from 'node:assert/strict';import {createRequire} from 'node:module';import {pathToFileURL} from 'node:url';import {dirname,resolve} from 'node:path';
+const require=createRequire(import.meta.url),root=dirname(require.resolve('@opsydyn/crumbs-css/package.json')),order=process.argv[2],trace=[];
+async function load(kind){const path=resolve(root,'dist/tokens-algebra.'+(kind==='require'?'cjs':'mjs'));const api=kind==='require'?require(path):await import(pathToFileURL(path).href);trace.push({kind,path});return api;}
+const first=order==='cjs-first'?'require':'import';const a=await load(first),b=await load(first==='require'?'import':'require');assert.equal(trace[0].kind,first);
+const tokens=require('@opsydyn/crumbs-css/tokens'),vars=tokens.createTokenContract({accent:tokens.defineToken('color'),spacing:tokens.defineToken({kind:'length',allowNegative:true})},{owner:'@fixture/algebra-installed',name:'a',version:1});const type=a.createTypography({fontSize:16,lineHeight:{ratio:1.5},letterSpacing:-.25});const theme=tokens.createTokenTheme(vars,{accent:b.toNativeColor(a.createColor('#1234')),spacing:b.toNativeTypography(type).letterSpacing});assert.equal(theme.values.accent,'#11223344');assert.equal(theme.values.spacing,-.25);const positive=tokens.createTokenContract({spacing:tokens.defineToken('length')},{owner:'@fixture/algebra-installed',name:'positive',version:1});assert.throws(()=>tokens.createTokenTheme(positive,{spacing:-.25}));console.log(JSON.stringify({order,trace,status:'passed'}));
