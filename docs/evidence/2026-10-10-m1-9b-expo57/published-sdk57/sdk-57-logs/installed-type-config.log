{
    "compilerOptions": {
        "allowJs": true,
        "esModuleInterop": true,
        "jsx": "react-jsx",
        "lib": [
            "dom",
            "esnext"
        ],
        "module": "preserve",
        "moduleDetection": "force",
        "moduleResolution": "bundler",
        "customConditions": [
            "react-native"
        ],
        "noEmit": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "target": "esnext",
        "strict": true
    },
    "files": [
        "./src/LocalVarsPanel.css.ts",
        "./src/context-plan.ts",
        "./src/env.d.ts",
        "./src/local-theme.ts",
        "./src/local-vars-model.ts",
        "./src/measurement-plan.ts",
        "./src/measurement.css.ts",
        "./src/memory-plan.ts",
        "./src/scope-plan.ts",
        "./src/screen.css.ts",
        "./src/scroll-plan.ts",
        "./src/theme.css.ts",
        "./src/shared-storybook/accessibility/native-condition-source.ts",
        "./src/shared-storybook/components/container-conditions/container-definitions.ts",
        "./src/shared-storybook/components/container-conditions/container-model.ts",
        "./src/shared-storybook/components/container-conditions/container-panel.css.ts",
        "./src/shared-storybook/components/native-motion/motion-definitions.ts",
        "./src/shared-storybook/components/native-motion/motion-model.ts",
        "./src/shared-storybook/components/native-motion/motion-panel.css.ts",
        "./src/shared-storybook/components/runtime-extensions/authoring.ts",
        "./src/shared-storybook/components/runtime-extensions/extension-model.ts",
        "./src/shared-storybook/components/runtime-extensions/extension-panel.css.ts",
        "./src/shared-storybook/components/token-algebra/algebra-model.ts",
        "./src/shared-storybook/components/token-algebra/algebra-panel.css.ts",
        "./src/App.tsx",
        "./src/ContainerConditionsPanel.tsx",
        "./src/ContextMeasurementPanel.tsx",
        "./src/GradientAcceptancePanel.tsx",
        "./src/LocalVarsPanel.tsx",
        "./src/MeasurementPanel.tsx",
        "./src/MemoryMeasurementPanel.tsx",
        "./src/NativeMotionPanel.tsx",
        "./src/RecipeScopePanel.tsx",
        "./src/RuntimeExtensionPanel.tsx",
        "./src/ScrollMeasurementPanel.tsx",
        "./src/TokenAlgebraPanel.tsx",
        "./src/TokenStylesPanel.tsx",
        "./src/motion.types.tsx",
        "./src/shared-storybook/components/container-conditions/ContainerPanel.tsx",
        "./src/shared-storybook/components/native-motion/MotionPanel.tsx",
        "./src/shared-storybook/components/runtime-extensions/ExtensionPanel.tsx",
        "./src/shared-storybook/components/runtime-extensions/runtime.tsx",
        "./src/shared-storybook/components/token-algebra/AlgebraPanel.tsx"
    ],
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx"
    ],
    "exclude": [
        "src/incremental*.ts"
    ]
}

