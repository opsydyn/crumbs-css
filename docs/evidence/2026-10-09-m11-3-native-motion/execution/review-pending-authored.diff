+export type NativeMotionChannel = 'opacity' | 'translateX' | 'translateY' | 'scale' | 'scaleX' | 'scaleY';
+export type NativeMotionEasing = 'linear' | 'ease-in' | 'ease-out' | 'ease-in-out';
