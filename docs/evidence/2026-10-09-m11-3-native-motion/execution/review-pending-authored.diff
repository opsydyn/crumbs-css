+test('all_channels_must_finish', () => { const h = harness(), r = h.request(); h.sample(r.cohort); h.send({ type: 'completed', epoch: h.epoch, run: r.run, channel: 'opacity', finished: true }); expect(h.results(r.run)).toEqual([]); h.send({ type: 'completed', epoch: h.epoch, run: r.run, channel: 'translateX', finished: false }); expect(h.results(r.run)).toEqual([{ status: 'cancelled', target: 'selected', reason: 'driver-stopped' }]); h.send({ type: 'completed', epoch: h.epoch, run: r.run, channel: 'translateX', finished: true }); expect(h.results(r.run)).toHaveLength(1); });
+test('cancel_does_not_mark_target_reached', () => { const h = harness(), r = h.request(); h.sample(r.cohort); h.send({ type: 'cancel', epoch: h.epoch, run: r.run }); const next = h.request(); expect(currentMotionRun(h.state)?.token).toBe(next.run); expect(h.results(next.run)).toEqual([]); expect(h.commands.filter(c => c.type === 'read')).toHaveLength(4); });
+test('reduced_motion_finishes_latest_target', () => { const h = harness(), first = h.request(), last = h.request('resting'); h.send({ type: 'options', epoch: h.epoch, options: { initial: 'selected', motion: 'reduced', duration: 60000 } }); expect(h.results(first.run)).toEqual([{ status: 'cancelled', target: 'selected', reason: 'superseded' }]); expect(h.results(last.run)).toEqual([{ status: 'finished', target: 'resting', mode: 'immediate' }]); expect(h.commands.filter(c => c.type === 'start')).toEqual([]); h.sample(first.cohort); expect(h.results(last.run)).toHaveLength(1); h.send({ type: 'options', epoch: h.epoch, options: { initial: 'selected', motion: 'full', duration: 180 } }); expect(currentMotionRun(h.state)).toBeUndefined(); });
+test('deactivate_retires_every_token', () => { const h = harness(), r = h.request(); h.send({ type: 'deactivate', epoch: h.epoch }); expect(h.results(r.run)).toEqual([{ status: 'cancelled', target: 'selected', reason: 'deactivated' }]); const before = h.commands.length; h.sample(r.cohort); h.send({ type: 'completed', epoch: h.epoch, run: r.run, channel: 'opacity', finished: true }); expect(h.commands.length).toBe(before); h.send({ type: 'activate', epoch: {}, options: { initial: 'resting', motion: 'full', duration: 180 } }); h.sample(r.cohort); expect(h.commands.length).toBe(before); });
