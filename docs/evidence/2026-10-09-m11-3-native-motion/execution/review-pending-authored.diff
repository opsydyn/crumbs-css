+import { expect, test } from 'bun:test';
+import { initialMotionScenario, updateMotionScenario } from '../src/components/native-motion/motion-model';
+test('fixture_independent_card_commands', () => { const first = initialMotionScenario(), next = updateMotionScenario(first, { type: 'request', card: 'a', target: 'selected' }); expect(next.requested).toEqual({ a: 'selected', b: 'resting' }); expect(first.requested).toEqual({ a: 'resting', b: 'resting' }); const b = updateMotionScenario(next, { type: 'request', card: 'b', target: 'selected' }); expect(b.requested).toEqual({ a: 'selected', b: 'selected' }); });
+test('bounded_parent_terminal_records_and_retired_mount_rejection', () => { let state = initialMotionScenario(); for (let i = 0; i < 100; i++)
+    state = updateMotionScenario(state, { type: 'terminal', card: 'b', generation: 0, result: { status: 'finished', target: i % 2 ? 'selected' : 'resting', mode: 'animated' } }); expect(state.terminals).toHaveLength(2); state = updateMotionScenario(state, { type: 'unmount' }); expect(updateMotionScenario(state, { type: 'terminal', card: 'a', generation: 0, result: { status: 'cancelled', target: 'selected', reason: 'deactivated' } })).toBe(state); state = updateMotionScenario(state, { type: 'remount' }); expect(state.aGeneration).toBe(1); expect(state.requested.a).toBe('resting'); expect(updateMotionScenario(state, { type: 'terminal', card: 'a', generation: 0, result: { status: 'finished', target: 'selected', mode: 'animated' } })).toBe(state); });
+test('stale_cancel_records_one_bounded_pending_run_observation',()=>{const initial=initialMotionScenario();const pending=updateMotionScenario(initial,{type:'stale-cancel',pending:true});expect(pending.staleCancelDuringPending).toBe(true);const finished=updateMotionScenario(pending,{type:'stale-cancel',pending:false});expect(finished.staleCancelDuringPending).toBe(false);expect(finished.terminals).toEqual([]);expect(finished.requested).toEqual(initial.requested)});
