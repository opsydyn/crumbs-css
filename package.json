{
  "name": "crumbs-css",
  "packageManager": "bun@1.3.11",
  "private": true,
  "workspaces": [
    "apps/*",
    "docs",
    "packages/*"
  ],
  "scripts": {
    "app:dev": "bun run --filter @crumbs/storybook dev",
    "app:storybook": "bun run --filter @crumbs/storybook storybook:native",
    "app:storybook:web": "bun run --filter @crumbs/storybook storybook:web",
    "app:typecheck": "bun run --filter @crumbs/storybook typecheck",
    "build": "bun run --filter @opsydyn/crumbs-css build",
    "budgets:readiness": "bun scripts/performance-budgets.ts readiness",
    "budgets:validate": "bun scripts/performance-budgets.ts validate",
    "check": "bun run build && bun run typecheck && bun run test",
    "dev": "bun run --filter @opsydyn/crumbs-css build",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run --cwd docs build",
    "release:check": "bun run --filter @opsydyn/crumbs-css release:check",
    "release:preflight": "bun scripts/release-preflight.ts",
    "test": "bun run --filter @opsydyn/crumbs-css test && bun run --filter @crumbs/storybook test",
    "typecheck": "bun run --filter @opsydyn/crumbs-css typecheck",
    "playground": "bun scripts/playground.ts workspace",
    "playground:packed": "bun scripts/playground.ts packed",
    "playground:published": "bun scripts/playground.ts published",
    "playground:distribution": "bun scripts/playground-distribution.ts",
    "playground:sdk-candidate": "bun scripts/playground-sdk-candidate.ts",
    "playground:check": "bun scripts/playground.ts workspace --check",
    "measure:editor": "bun scripts/editor-scale.ts measure",
    "measure:host-budgets": "bun scripts/measure-current-host-budgets.ts",
    "measure:metro-incremental": "bun packages/css/bench/metro-incremental.ts",
    "measure:runtime-graph-budgets": "bun scripts/measure-runtime-graph-budgets.ts",
    "manifest:check": "bun scripts/m9-2-manifest-check.ts",
    "migrate:source": "bun scripts/m9-5-migrations.ts",
    "migrations:qualify": "bun scripts/m9-5-migrations-qualification.ts",
    "manifest:qualify": "bun run build && bun scripts/m9-1-manifest-qualification.ts",
    "policy:check": "bun scripts/m9-4-policy-check.ts"
  }
}
